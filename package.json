{
  "name": "dionce-ai-website",
  "version": "1.0.0",
  "description": "Dionce AI - Agentic AI Platform Company Website",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "sync:cx-fonts": "node src/app/pages/cx/fonts/sync-cx-fonts.mjs",
    "verify:cx-layout": "node src/app/pages/cx/layout/verify-section-rhythm.mjs",
    "verify:cx-placeholders": "node src/app/pages/cx/layout/verify-cx-placeholders.mjs",
    "lint:cx-styles": "stylelint \"src/app/pages/cx/**/*.scss\"",
    "build": "npm run sync:cx-fonts && npm run verify:cx-layout && npm run verify:cx-placeholders && npm run lint:cx-styles && ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:prod": "ng serve --configuration production"
  },
  "private": true,
  "dependencies": {
    "@amcharts/amcharts5": "^5.15.0",
    "@angular/animations": "^17.0.0",
    "@angular/common": "^17.0.0",
    "@angular/compiler": "^17.0.0",
    "@angular/core": "^17.0.0",
    "@angular/forms": "^17.0.0",
    "@angular/platform-browser": "^17.0.0",
    "@angular/platform-browser-dynamic": "^17.0.0",
    "@angular/router": "^17.0.0",
    "@emailjs/browser": "^4.4.1",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/instrument-sans": "^5.3.0",
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "@fortawesome/fontawesome-svg-core": "^7.1.0",
    "@fortawesome/free-solid-svg-icons": "^7.1.0",
    "@hugeicons/angular": "^1.0.6",
    "@hugeicons/core-free-icons": "^3.1.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "vis-data": "^8.0.3",
    "vis-network": "^10.0.2",
    "zone.js": "~0.14.2"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.0.0",
    "@angular/cli": "^17.0.0",
    "@angular/compiler-cli": "^17.0.0",
    "@types/node": "^20.0.0",
    "autoprefixer": "^10.4.23",
    "postcss": "^8.5.6",
    "stylelint": "^16.19.1",
    "stylelint-config-standard-scss": "^14.0.0",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.2.2"
  }
}
